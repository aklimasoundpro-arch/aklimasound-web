# ============================================================
#  Aklimasound — variables d'environnement
#  Copier ce fichier vers .env.local (jamais committé) pour le dev local.
#  Sur Netlify : Site configuration → Environment variables.
#  AUCUNE de ces valeurs ne doit commencer par NEXT_PUBLIC_ (elles resteraient
#  côté serveur ; la clé service_role est le passe-partout de la base).
# ============================================================

# Supabase — Dashboard → Settings → API
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_KEY=eyJ...votre_cle_service_role...

# Optionnel (recommandé) : clé anon, utilisée uniquement côté serveur pour les
# appels Auth (GoTrue). À défaut, la clé service_role est employée.
SUPABASE_ANON_KEY=eyJ...votre_cle_anon...

# URL publique du site — sert aux redirections des e-mails (confirmation,
# réinitialisation de mot de passe). En dev local : http://localhost:3000
SITE_URL=https://aklimasound.tg
